DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hema-club-georgia
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public URL of this deployment — used to build links in emails (invite, password reset).
SERVER_URL=http://localhost:3000

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<r2-bucket-name>
R2_PUBLIC_URL=https://media.example.com

# Resend (transactional email: user invites, password reset)
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM_ADDRESS=no-reply@hemageogia.com
